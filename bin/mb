#!/usr/bin/env bash
# mb - MetaBot API CLI (installed by MetaBot)
# Standalone executable — works without sourcing any file.

set -euo pipefail

# --- Config: always read .env, then fall back to env vars / defaults ---
METABOT_ENV="${METABOT_HOME:-$HOME/metabot}/.env"
if [[ -f "$METABOT_ENV" ]]; then
  _port=$(sed -n 's/^API_PORT=//p' "$METABOT_ENV" 2>/dev/null || true)
  _secret=$(sed -n 's/^API_SECRET=//p' "$METABOT_ENV" 2>/dev/null || true)
  _url=$(sed -n 's/^METABOT_URL=//p' "$METABOT_ENV" 2>/dev/null || true)
fi
METABOT_URL="${METABOT_URL:-${_url:-http://localhost:${_port:-9100}}}"
_secret="${_secret:-${API_SECRET:-changeme}}"
METABOT_AUTH="Authorization: Bearer $_secret"

_json() { python3 -m json.tool 2>/dev/null || cat; }

# Pretty-print an API response and fail the shell command when the JSON reports
# a terminal failure. A completed consensus may still contain ejected bots; in
# that case print their execution errors to stderr while preserving exit 0 when
# quorum reached consensus.
_json_checked() {
  python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    obj = json.loads(raw)
except Exception:
    sys.stdout.write(raw)
    sys.exit(1)

print(json.dumps(obj, ensure_ascii=False, indent=2))

failed = obj.get("success") is False or obj.get("status") == "failed"
result = obj.get("result")
if isinstance(result, dict):
    failed = failed or result.get("success") is False
    inner = result.get("responseText")
    if isinstance(inner, str):
        try:
            consensus = json.loads(inner)
        except Exception:
            consensus = None
        if isinstance(consensus, dict):
            for entry in consensus.get("ejectedBots", []):
                if isinstance(entry, dict) and entry.get("reason") == "execution_error":
                    bot = entry.get("bot", "unknown")
                    detail = entry.get("detail", "upstream execution error")
                    print(f"mb: consensus bot {bot} ejected: {detail}", file=sys.stderr)

sys.exit(1 if failed else 0)
'
}

_api_json() {
  local tmp http_code curl_status=0 body_status=0
  tmp="$(mktemp "${TMPDIR:-/tmp}/mb-api.XXXXXX")"
  http_code="$(curl -sS -o "$tmp" -w '%{http_code}' "$@")" || curl_status=$?
  _json_checked < "$tmp" || body_status=$?
  rm -f "$tmp"

  if [[ $curl_status -ne 0 ]]; then
    echo "mb: API transport failed (curl exit $curl_status)" >&2
    return "$curl_status"
  fi
  if [[ "$http_code" =~ ^[0-9]{3}$ ]] && (( http_code >= 400 )); then
    echo "mb: API request failed (HTTP $http_code)" >&2
    return 1
  fi
  return "$body_status"
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  # --- Bot management ---
  bots|b)
    curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/bots" | _json
    ;;
  bot)
    curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/bots/$1" | _json
    ;;
  # --- Agent Talk (cross-instance auto-routing) ---
  # Env var MB_CALLER_BOT, when set, marks the calling bot identity. The API
  # then posts the outgoing prompt as a visible card under that bot's name
  # before invoking the target — so inter-bot conversations show both sides
  # in the real group chat.
  talk|t)
    bot="$1" chat="$2"; shift 2 2>/dev/null || true
    prompt="$*"
    caller="${MB_CALLER_BOT:-}"
    if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${prompt:-}" ]]; then
      echo "Usage: mb talk [peer/]<botName> <chatId> <prompt>"
      echo "  Examples:"
      echo "    mb talk mybot chat123 'fix the bug'"
      echo "    mb talk alice/backend-bot chat123 'deploy to staging'"
      echo "  Optional: set MB_CALLER_BOT=<botName> to make outgoing prompt visible in chat"
      exit 1
    fi
    python3 -c "
import json, sys
out = {'botName': sys.argv[1], 'chatId': sys.argv[2], 'prompt': sys.argv[3], 'sendCards': True}
if sys.argv[4]:
    out['callerBot'] = sys.argv[4]
print(json.dumps(out))
" "$bot" "$chat" "$prompt" "$caller" | \
    _api_json -X POST "$METABOT_URL/api/talk" \
      -H "$METABOT_AUTH" -H "Content-Type: application/json" \
      -d @-
    ;;
  # --- N-Bot Consensus Protocol ---
  # Drives a 5-phase multi-bot discussion to reasoned consensus (or surfaces
  # standing disagreements honestly). Async only — typical runtime 5-15 min.
  consensus|cons)
    subcmd="${1:-help}"; shift 2>/dev/null || true
    case "$subcmd" in
      start)
        consensus_profile=""
        bots=""
        problem=""
        type_=""
        stakes=""
        consensus_chat=""
        consensus_caller=""
        consensus_synth=""
        cost_cap=""
        max_rounds=""
        positionals=()
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --profile)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --profile"; exit 1; fi
              consensus_profile="${2:-}"; shift 2 ;;
            --chat)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --chat"; exit 1; fi
              consensus_chat="${2:-}"; shift 2 ;;
            --caller)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --caller"; exit 1; fi
              consensus_caller="${2:-}"; shift 2 ;;
            --synthesizer)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --synthesizer"; exit 1; fi
              consensus_synth="${2:-}"; shift 2 ;;
            --type)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --type"; exit 1; fi
              type_="${2:-}"; shift 2 ;;
            --stakes)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --stakes"; exit 1; fi
              stakes="${2:-}"; shift 2 ;;
            --cost-cap)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --cost-cap"; exit 1; fi
              cost_cap="${2:-}"; shift 2 ;;
            --max-rounds)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --max-rounds"; exit 1; fi
              max_rounds="${2:-}"; shift 2 ;;
            *)
              positionals+=("$1"); shift ;;
          esac
        done
        tail_start=0
        if [[ -n "$consensus_profile" ]]; then
          if [[ ${#positionals[@]} -ge 2 && "${positionals[0]}" == *,* ]]; then
            bots="${positionals[0]}"
            problem="${positionals[1]}"
            tail_start=2
          else
            problem="${positionals[0]:-}"
            tail_start=1
          fi
        else
          bots="${positionals[0]:-}"
          problem="${positionals[1]:-}"
          tail_start=2
        fi
        if [[ -z "$type_" ]]; then
          candidate="${positionals[$tail_start]:-}"
          case "$candidate" in
            empirical|architectural|preference)
              type_="$candidate"; tail_start=$((tail_start + 1)) ;;
            *)
              type_="architectural" ;;
          esac
        fi
        if [[ -z "$stakes" ]]; then
          candidate="${positionals[$tail_start]:-}"
          case "$candidate" in
            low|medium|high)
              stakes="$candidate"; tail_start=$((tail_start + 1)) ;;
            *)
              stakes="medium" ;;
          esac
        fi
        [[ -z "$consensus_chat" ]] && consensus_chat="${positionals[$tail_start]:-}" && tail_start=$((tail_start + 1))
        [[ -z "$consensus_caller" ]] && consensus_caller="${positionals[$tail_start]:-}" && tail_start=$((tail_start + 1))
        [[ -z "$consensus_synth" ]] && consensus_synth="${positionals[$tail_start]:-}" && tail_start=$((tail_start + 1))
        if [[ -n "${positionals[$tail_start]:-}" ]]; then
          echo "Unexpected argument: ${positionals[$tail_start]}"
          echo "Usage: mb consensus start [--profile name] [bot1,bot2,...] <problem> [type] [stakes] [chatId] [callerBot] [synthesizerBot]"
          exit 1
        fi
        if [[ -z "$problem" || ( -z "$bots" && -z "$consensus_profile" ) ]]; then
          echo "Usage: mb consensus start [--profile name] [bot1,bot2,...] <problem> [type] [stakes] [chatId] [callerBot] [synthesizerBot]"
          echo "  bots:       comma-separated, 2-4 bots (e.g. project-alpha,project-beta)"
          echo "  profile:    optional named consensus profile from bots.json"
          echo "  type:       empirical | architectural (default) | preference"
          echo "  stakes:     low | medium (default) | high"
          echo "  chatId:     optional — group chatId to surface event cards"
          echo "  callerBot:  optional (required if chatId set) — bot identity"
          echo "              used to post the cards (e.g. project-alpha)"
          echo "  synthesizerBot: optional non-panelist bot for Phase 4 synthesis"
          exit 1
        fi
        python3 -c "
import json, sys
out = {'problem': sys.argv[3], 'type': sys.argv[4], 'stakes': sys.argv[5]}
if sys.argv[1]:
    out['profile'] = sys.argv[1]
if sys.argv[2]:
    out['bots'] = sys.argv[2].split(',')
if sys.argv[6]:
    out['chatId'] = sys.argv[6]
if sys.argv[7]:
    out['callerBotName'] = sys.argv[7]
if sys.argv[8]:
    out['synthesizerBot'] = sys.argv[8]
if sys.argv[9]:
    out['costCapUsd'] = float(sys.argv[9])
if sys.argv[10]:
    out['maxRounds'] = int(sys.argv[10])
print(json.dumps(out))
" "$consensus_profile" "$bots" "$problem" "$type_" "$stakes" "$consensus_chat" "$consensus_caller" "$consensus_synth" "$cost_cap" "$max_rounds" | \
        _api_json -X POST "$METABOT_URL/api/consensus" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d @-
        ;;
      profiles|profile|ls)
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/consensus/profiles" | _json
        ;;
      doctor|dry-run)
        dry_run="false"
        [[ "$subcmd" == "dry-run" ]] && dry_run="true"
        consensus_profile=""
        bots=""
        consensus_chat=""
        consensus_caller=""
        consensus_synth=""
        type_=""
        stakes=""
        positionals=()
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --profile)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --profile"; exit 1; fi
              consensus_profile="${2:-}"; shift 2 ;;
            --chat)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --chat"; exit 1; fi
              consensus_chat="${2:-}"; shift 2 ;;
            --caller)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --caller"; exit 1; fi
              consensus_caller="${2:-}"; shift 2 ;;
            --synthesizer)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --synthesizer"; exit 1; fi
              consensus_synth="${2:-}"; shift 2 ;;
            --type)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --type"; exit 1; fi
              type_="${2:-}"; shift 2 ;;
            --stakes)
              if [[ -z "${2:-}" ]]; then echo "Missing value for --stakes"; exit 1; fi
              stakes="${2:-}"; shift 2 ;;
            *)
              positionals+=("$1"); shift ;;
          esac
        done
        if [[ ${#positionals[@]} -gt 0 ]]; then
          if [[ "${positionals[0]}" == *,* ]]; then
            bots="${positionals[0]}"
            [[ -z "$consensus_chat" ]] && consensus_chat="${positionals[1]:-}"
            [[ -z "$consensus_caller" ]] && consensus_caller="${positionals[2]:-}"
          else
            [[ -z "$consensus_profile" ]] && consensus_profile="${positionals[0]}"
            [[ -z "$consensus_chat" ]] && consensus_chat="${positionals[1]:-}"
            [[ -z "$consensus_caller" ]] && consensus_caller="${positionals[2]:-}"
          fi
        fi
        python3 -c "
import json, sys
out = {'dryRun': sys.argv[8] == 'true'}
if sys.argv[1]:
    out['profile'] = sys.argv[1]
if sys.argv[2]:
    out['bots'] = sys.argv[2].split(',')
if sys.argv[3]:
    out['chatId'] = sys.argv[3]
if sys.argv[4]:
    out['callerBotName'] = sys.argv[4]
if sys.argv[5]:
    out['synthesizerBot'] = sys.argv[5]
if sys.argv[6]:
    out['type'] = sys.argv[6]
if sys.argv[7]:
    out['stakes'] = sys.argv[7]
print(json.dumps(out))
" "$consensus_profile" "$bots" "$consensus_chat" "$consensus_caller" "$consensus_synth" "$type_" "$stakes" "$dry_run" | \
        curl -s -X POST "$METABOT_URL/api/consensus/doctor" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d @- | _json
        ;;
      get|status|s)
        tid="${1:-}"
        if [[ -z "$tid" ]]; then
          echo "Usage: mb consensus get <taskId>"
          exit 1
        fi
        _api_json -H "$METABOT_AUTH" "$METABOT_URL/api/consensus/$tid"
        ;;
      *)
        echo "Usage:"
        echo "  mb consensus start [--profile name] [bot1,bot2,...] <problem> [type] [stakes] [chatId] [callerBot] [synthesizerBot]"
        echo "  mb consensus profiles"
        echo "  mb consensus doctor [profile|bot1,bot2,...] [chatId] [callerBot]"
        echo "  mb consensus dry-run [profile|bot1,bot2,...] [chatId] [callerBot]"
        echo "  mb consensus get <taskId>"
        exit 1
        ;;
    esac
    ;;
  # --- Task delegation (deprecated alias for talk) ---
  task)
    bot="$1" chat="$2"; shift 2 2>/dev/null || true
    prompt="$*"
    if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${prompt:-}" ]]; then
      echo "Usage: mb task <botName> <chatId> <prompt>"
      echo "(Deprecated: use 'mb talk' instead)"
      exit 1
    fi
    python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'chatId': sys.argv[2], 'prompt': sys.argv[3], 'sendCards': True}))
" "$bot" "$chat" "$prompt" | \
    curl -s -X POST "$METABOT_URL/api/talk" \
      -H "$METABOT_AUTH" -H "Content-Type: application/json" \
      -d @-
    ;;
  # --- Scheduling ---
  schedule|sched|sc)
    subcmd="${1:-list}"; shift 2>/dev/null || true
    case "$subcmd" in
      list|ls)
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/schedule" | _json
        ;;
      add|a)
        bot="$1" chat="$2" delay="$3"; shift 3 2>/dev/null || true
        prompt="$*"
        if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${delay:-}" || -z "${prompt:-}" ]]; then
          echo "Usage: mb schedule add <botName> <chatId> <delaySeconds> <prompt>"
          exit 1
        fi
        python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'chatId': sys.argv[2], 'delaySeconds': int(sys.argv[3]), 'prompt': sys.argv[4]}))
" "$bot" "$chat" "$delay" "$prompt" | \
        curl -s -X POST "$METABOT_URL/api/schedule" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d @- | _json
        ;;
      cron|c)
        bot="$1" chat="$2" cron_expr="$3"; shift 3 2>/dev/null || true
        prompt="$*"
        if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${cron_expr:-}" || -z "${prompt:-}" ]]; then
          echo "Usage: mb schedule cron <botName> <chatId> '<cronExpr>' <prompt>"
          echo "  Example: mb schedule cron mybot oc_xxx '0 8 * * 1-5' Generate daily report"
          exit 1
        fi
        python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'chatId': sys.argv[2], 'cronExpr': sys.argv[3], 'prompt': sys.argv[4]}))
" "$bot" "$chat" "$cron_expr" "$prompt" | \
        curl -s -X POST "$METABOT_URL/api/schedule" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d @- | _json
        ;;
      pause|p)
        if [[ -z "${1:-}" ]]; then echo "Usage: mb schedule pause <id>"; exit 1; fi
        curl -s -X POST "$METABOT_URL/api/schedule/$1/pause" -H "$METABOT_AUTH" | _json
        ;;
      resume|r)
        if [[ -z "${1:-}" ]]; then echo "Usage: mb schedule resume <id>"; exit 1; fi
        curl -s -X POST "$METABOT_URL/api/schedule/$1/resume" -H "$METABOT_AUTH" | _json
        ;;
      cancel|rm)
        if [[ -z "${1:-}" ]]; then echo "Usage: mb schedule cancel <id>"; exit 1; fi
        curl -s -X DELETE "$METABOT_URL/api/schedule/$1" -H "$METABOT_AUTH" | _json
        ;;
      *)
        echo "mb schedule - Task scheduling"
        echo "  mb schedule list                                    - List all scheduled tasks"
        echo "  mb schedule add <bot> <chatId> <delaySec> <prompt>  - Schedule a one-time task"
        echo "  mb schedule cron <bot> <chatId> '<cron>' <prompt>   - Schedule a recurring task"
        echo "  mb schedule pause <id>                              - Pause a recurring task"
        echo "  mb schedule resume <id>                             - Resume a paused task"
        echo "  mb schedule cancel <id>                             - Cancel a task"
        ;;
    esac
    ;;
  # --- Peers ---
  peers|p)
    curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/peers" | _json
    ;;
  # --- Stats & Metrics ---
  stats|st)
    curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/stats" | _json
    ;;
  metrics|m)
    curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/metrics"
    ;;
  # --- RTC Voice Call ---
  voice|v)
    subcmd="${1:-help}"; shift 2>/dev/null || true
    case "$subcmd" in
      call|c)
        bot="${1:-}" chat="${2:-}"; shift 2 2>/dev/null || true
        _welcome=""
        _prompt=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            -w|--welcome) _welcome="$2"; shift 2 ;;
            *)            _prompt="${_prompt:+$_prompt }$1"; shift ;;
          esac
        done
        if [[ -z "${bot:-}" || -z "${chat:-}" ]]; then
          echo "Usage: mb voice call <botName> <chatId> [prompt] [-w welcomeMessage]"
          echo "  Initiates an RTC voice call. Notifies the web/iOS user,"
          echo "  waits for the call to end, and returns the transcript."
          echo ""
          echo "  Options:"
          echo "    -w, --welcome <text>  AI's opening line (what it says first)"
          echo ""
          echo "  Examples:"
          echo "    mb voice call whis chat123 'Tell user they are awesome' -w 'Flood, 你是最棒的！'"
          echo "    mb voice call whis chat123 -w 'Hi! I wanted to discuss the project progress.'"
          exit 1
        fi
        echo "Starting voice call... (waiting for user to join and call to end)"
        python3 -c "
import json, sys
p = {'botName': sys.argv[1], 'chatId': sys.argv[2]}
if sys.argv[3]: p['prompt'] = sys.argv[3]
if sys.argv[4]: p['welcomeMessage'] = sys.argv[4]
print(json.dumps(p))
" "$bot" "$chat" "${_prompt:-}" "${_welcome:-}" | \
        curl -s -X POST "$METABOT_URL/api/rtc/voice?wait=true" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          --max-time 660 \
          -d @- | _json
        ;;
      transcript|t)
        if [[ -z "${1:-}" ]]; then echo "Usage: mb voice transcript <sessionId>"; exit 1; fi
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/rtc/transcript?sessionId=$1" | _json
        ;;
      list|ls)
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/rtc/sessions" | _json
        ;;
      config)
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/rtc/config" | _json
        ;;
      tts)
        _provider=""
        _voice=""
        _output=""
        _play=false
        _text=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --provider|-p) _provider="$2"; shift 2 ;;
            --voice)       _voice="$2"; shift 2 ;;
            -o|--output)   _output="$2"; shift 2 ;;
            --play)        _play=true; shift ;;
            --)            shift; _text="$*"; break ;;
            -*)            echo "Unknown flag: $1"; exit 1 ;;
            *)             _text="$*"; break ;;
          esac
        done
        if [[ -z "$_text" ]]; then
          if [[ -t 0 ]]; then
            echo "Usage: mb voice tts \"text\" [--play] [-o file.mp3] [--provider doubao|openai|elevenlabs] [--voice <name>]"
            echo "  Or pipe text: echo 'hello' | mb voice tts"
            exit 1
          fi
          _text="$(cat)"
        fi
        _json_body=$(python3 -c "
import json, sys
body = {'text': sys.argv[1]}
if sys.argv[2]: body['provider'] = sys.argv[2]
if sys.argv[3]: body['voice'] = sys.argv[3]
print(json.dumps(body))
" "$_text" "$_provider" "$_voice")
        if [[ -z "$_output" ]]; then
          _output="/tmp/mb-voice-$(date +%s).mp3"
        fi
        _http_code=$(curl -s -w '%{http_code}' -o "$_output" \
          -X POST "$METABOT_URL/api/tts" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d "$_json_body")
        if [[ "$_http_code" != "200" ]]; then
          echo "Error: TTS request failed (HTTP $_http_code)"
          cat "$_output" 2>/dev/null
          rm -f "$_output"
          exit 1
        fi
        echo "$_output"
        if [[ "$_play" == "true" ]]; then
          if command -v afplay &>/dev/null; then afplay "$_output"
          elif command -v mpv &>/dev/null; then mpv --no-video "$_output" 2>/dev/null
          elif command -v ffplay &>/dev/null; then ffplay -nodisp -autoexit "$_output" 2>/dev/null
          elif command -v play &>/dev/null; then play "$_output" 2>/dev/null
          else echo "(no audio player found — install mpv, ffplay, or sox to use --play)"
          fi
        fi
        ;;
      *)
        echo "mb voice - Voice tools"
        echo ""
        echo "  RTC Voice Call:"
        echo "    mb voice call <bot> <chatId> [prompt] [-w opening]  - Start voice call"
        echo "    mb voice transcript <sessionId>         - Get call transcript"
        echo "    mb voice list                           - List active voice sessions"
        echo "    mb voice config                         - Check RTC configuration"
        echo ""
        echo "  Text-to-Speech:"
        echo "    mb voice tts \"text\" [--play] [-o f]    - Generate MP3 from text"
        echo "    mb voice tts \"text\" --provider doubao   - Use specific TTS provider"
        echo "    echo 'hello' | mb voice tts              - Read from stdin"
        ;;
    esac
    ;;
  # --- Skill Hub ---
  skills|sk)
    subcmd="${1:-list}"; shift 2>/dev/null || true
    case "$subcmd" in
      list|ls)
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/skills" | _json
        ;;
      search|s)
        query="$*"
        if [[ -z "${query:-}" ]]; then echo "Usage: mb skills search <query>"; exit 1; fi
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/skills/search?q=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$query")" | _json
        ;;
      get|g)
        if [[ -z "${1:-}" ]]; then echo "Usage: mb skills get <name>"; exit 1; fi
        curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/skills/$1" | _json
        ;;
      publish|pub)
        bot="${1:-}" skill="${2:-}"
        if [[ -z "$bot" || -z "$skill" ]]; then
          echo "Usage: mb skills publish <botName> <skillName>"
          exit 1
        fi
        curl -s -X POST "$METABOT_URL/api/skills/$skill/publish-from-bot" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d "{\"botName\":\"$bot\"}" | _json
        ;;
      install|i)
        skill="${1:-}" bot="${2:-}"
        if [[ -z "$skill" || -z "$bot" ]]; then
          echo "Usage: mb skills install <skillName> <botName>"
          exit 1
        fi
        source="${3:-local}"
        python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'source': sys.argv[2]}))
" "$bot" "$source" | \
        curl -s -X POST "$METABOT_URL/api/skills/$skill/install" \
          -H "$METABOT_AUTH" -H "Content-Type: application/json" \
          -d @- | _json
        ;;
      remove|rm)
        if [[ -z "${1:-}" ]]; then echo "Usage: mb skills remove <name>"; exit 1; fi
        curl -s -X DELETE "$METABOT_URL/api/skills/$1" -H "$METABOT_AUTH" | _json
        ;;
      *)
        echo "mb skills - Skill Hub (shared skill registry)"
        echo "  mb skills list                               - List all skills (local + peer)"
        echo "  mb skills search <query>                     - Search skills by keyword"
        echo "  mb skills get <name>                         - Get skill details"
        echo "  mb skills publish <botName> <skillName>      - Publish a bot's skill to the hub"
        echo "  mb skills install <skillName> <botName>      - Install a skill to a bot"
        echo "  mb skills remove <name>                      - Unpublish a skill"
        ;;
    esac
    ;;
  # --- Health ---
  health|h)
    curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/health" | _json
    ;;
  # --- Update from GitHub ---
  update|up)
    METABOT_SRC="${METABOT_HOME:-$HOME/metabot}"
    LOCAL_BIN="$HOME/.local/bin"
    if [[ ! -d "$METABOT_SRC/.git" ]]; then
      echo "Error: MetaBot repo not found at $METABOT_SRC"
      exit 1
    fi

    echo "==> Pulling latest from GitHub..."
    git -C "$METABOT_SRC" pull --ff-only || { echo "Error: git pull failed (try resolving conflicts manually)"; exit 1; }

    echo "==> Installing dependencies..."
    (cd "$METABOT_SRC" && npm install --include=dev --no-audit --no-fund 2>&1 | tail -1)

    echo "==> Building..."
    (cd "$METABOT_SRC" && npm run build 2>&1) || { echo "Error: build failed"; exit 1; }

    echo "==> Updating CLI tools..."
    mkdir -p "$LOCAL_BIN"
    for cli in mb mm metabot; do
      src="$METABOT_SRC/bin/$cli"
      dst="$LOCAL_BIN/$cli"
      if [[ -f "$src" ]]; then
        if ! cmp -s "$src" "$dst" 2>/dev/null; then
          cp "$src" "$dst"
          chmod +x "$dst"
          echo "    Updated: $cli"
        fi
      fi
    done

    echo "==> Updating skills..."
    SKILLS_DIR="$HOME/.claude/skills"
    mkdir -p "$SKILLS_DIR"
    for skill in metaskill metamemory metabot voice phone-call skill-hub; do
      case "$skill" in
        metaskill)   src="$METABOT_SRC/src/skills/metaskill" ;;
        metamemory)  src="$METABOT_SRC/src/memory/skill" ;;
        metabot)     src="$METABOT_SRC/src/skills/metabot" ;;
        voice)       src="$METABOT_SRC/src/skills/voice" ;;
        phone-call)  src="$METABOT_SRC/src/skills/phone-call" ;;
        skill-hub)   src="$METABOT_SRC/src/skills/skill-hub" ;;
        *)           src="" ;;
      esac
      if [[ -n "$src" && -d "$src" ]]; then
        mkdir -p "$SKILLS_DIR/$skill"
        cp -r "$src/." "$SKILLS_DIR/$skill/"
        echo "    Updated: $skill"
      fi
    done
    # Clean up legacy feishu-doc skill
    if [[ -d "$SKILLS_DIR/feishu-doc" ]]; then
      rm -rf "$SKILLS_DIR/feishu-doc"
      echo "    Removed legacy: feishu-doc"
    fi

    # Check if lark-cli skills were previously installed (opt-in via install.sh)
    has_lark_skills=false
    if [[ -d "$SKILLS_DIR/lark-doc" ]]; then
      has_lark_skills=true
    fi

    # Update workspace skills if bots.json exists
    if [[ -f "$METABOT_SRC/bots.json" ]] && command -v node &>/dev/null; then
      work_dir=$(node -e "
        const c=JSON.parse(require('fs').readFileSync('$METABOT_SRC/bots.json','utf-8'));
        const b=[...(c.feishuBots||[]),...(c.telegramBots||[]),...(c.wechatBots||[])];
        if(b[0])console.log(b[0].defaultWorkingDirectory);
      " 2>/dev/null || true)
      if [[ -n "${work_dir:-}" ]]; then
        ws_skills_dir="$work_dir/.claude/skills"
        mkdir -p "$ws_skills_dir"
        for skill in metaskill metamemory metabot voice phone-call skill-hub; do
          if [[ -d "$SKILLS_DIR/$skill" ]]; then
            mkdir -p "$ws_skills_dir/$skill"
            cp -r "$SKILLS_DIR/$skill/." "$ws_skills_dir/$skill/"
          fi
        done
        # Copy lark-cli skills if previously installed
        if [[ "${has_lark_skills:-false}" == "true" ]]; then
          for lark_skill in lark-base lark-calendar lark-contact lark-doc lark-drive lark-event lark-im lark-mail lark-minutes lark-openapi-explorer lark-shared lark-sheets lark-skill-maker lark-task lark-vc lark-whiteboard lark-wiki lark-workflow-meeting-summary lark-workflow-standup-report; do
            if [[ -d "$SKILLS_DIR/$lark_skill" ]]; then
              mkdir -p "$ws_skills_dir/$lark_skill"
              cp -r "$SKILLS_DIR/$lark_skill/." "$ws_skills_dir/$lark_skill/"
            fi
          done
        fi
        # Clean up legacy feishu-doc in workspace
        if [[ -d "$ws_skills_dir/feishu-doc" ]]; then
          rm -rf "$ws_skills_dir/feishu-doc"
        fi
        if [[ -f "$METABOT_SRC/src/workspace/CLAUDE.md" ]]; then
          cp "$METABOT_SRC/src/workspace/CLAUDE.md" "$work_dir/CLAUDE.md"
        fi
      fi
    fi

    echo "==> Restarting service..."
    if command -v pm2 &>/dev/null && pm2 list 2>/dev/null | grep -q metabot; then
      pm2 restart metabot && echo "    Restarted via pm2"
    elif pgrep -f "tsx src/index" &>/dev/null; then
      pkill -f "tsx src/index"
      (cd "$METABOT_SRC" && nohup npm run dev > /tmp/metabot.log 2>&1 &)
      echo "    Restarted dev server (PID $!)"
    elif pgrep -f "node dist/index" &>/dev/null; then
      pkill -f "node dist/index"
      (cd "$METABOT_SRC" && nohup npm start > /tmp/metabot.log 2>&1 &)
      echo "    Restarted production server (PID $!)"
    else
      echo "    No running MetaBot process found. Start manually:"
      echo "    cd $METABOT_SRC && npm run dev"
    fi

    echo "==> Update complete!"
    ;;
  # --- Text-to-Speech ---
  voice|v)
    _provider=""
    _voice=""
    _output=""
    _play=false
    _text=""

    # Parse flags
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --provider|-p) _provider="$2"; shift 2 ;;
        --voice)       _voice="$2"; shift 2 ;;
        -o|--output)   _output="$2"; shift 2 ;;
        --play)        _play=true; shift ;;
        --)            shift; _text="$*"; break ;;
        -*)            echo "Unknown flag: $1"; exit 1 ;;
        *)             _text="$*"; break ;;
      esac
    done

    # Read from stdin if no text argument
    if [[ -z "$_text" ]]; then
      if [[ -t 0 ]]; then
        echo "Usage: mb voice \"text to speak\" [--play] [-o file.mp3] [--provider doubao|openai|elevenlabs] [--voice <name>]"
        echo "  Or pipe text: echo 'hello' | mb voice"
        exit 1
      fi
      _text="$(cat)"
    fi

    # Build JSON body
    _json_body=$(python3 -c "
import json, sys
body = {'text': sys.argv[1]}
if sys.argv[2]: body['provider'] = sys.argv[2]
if sys.argv[3]: body['voice'] = sys.argv[3]
print(json.dumps(body))
" "$_text" "$_provider" "$_voice")

    # Default output filename
    if [[ -z "$_output" ]]; then
      _output="/tmp/mb-voice-$(date +%s).mp3"
    fi

    # Call API
    _http_code=$(curl -s -w '%{http_code}' -o "$_output" \
      -X POST "$METABOT_URL/api/tts" \
      -H "$METABOT_AUTH" -H "Content-Type: application/json" \
      -d "$_json_body")

    if [[ "$_http_code" != "200" ]]; then
      echo "Error: TTS request failed (HTTP $_http_code)"
      cat "$_output" 2>/dev/null
      rm -f "$_output"
      exit 1
    fi

    echo "$_output"

    # Play if requested
    if [[ "$_play" == "true" ]]; then
      if command -v afplay &>/dev/null; then
        afplay "$_output"
      elif command -v mpv &>/dev/null; then
        mpv --no-video "$_output" 2>/dev/null
      elif command -v ffplay &>/dev/null; then
        ffplay -nodisp -autoexit "$_output" 2>/dev/null
      elif command -v play &>/dev/null; then
        play "$_output" 2>/dev/null
      else
        echo "(no audio player found — install mpv, ffplay, or sox to use --play)"
      fi
    fi
    ;;
  # --- Help ---
  *)
    echo "mb - MetaBot API CLI"
    echo ""
    echo "  Bots:"
    echo "    mb bots                          - List all bots (local + peer)"
    echo "    mb bot <name>                    - Get bot details"
    echo ""
    echo "  Agent Talk:"
    echo "    mb talk <bot> <chatId> <prompt>  - Talk to a bot (auto-routes to peers)"
    echo "    mb talk peer/bot <chatId> <prompt> - Talk to a specific peer's bot"
    echo ""
    echo "  Peers:"
    echo "    mb peers                         - List peers and their status"
    echo ""
    echo "  Scheduling:"
    echo "    mb schedule list                 - List all scheduled tasks"
    echo "    mb schedule add <bot> <chatId> <delaySec> <prompt>"
    echo "    mb schedule cron <bot> <chatId> '<cron>' <prompt>"
    echo "    mb schedule pause <id>           - Pause a recurring task"
    echo "    mb schedule resume <id>          - Resume a paused task"
    echo "    mb schedule cancel <id>          - Cancel a scheduled task"
    echo ""
    echo "  Voice:"
    echo "    mb voice call <bot> <chatId> [prompt] [-w opening] - Start voice call"
    echo "    mb voice transcript <sessionId>  - Get call transcript"
    echo "    mb voice list                    - List active voice sessions"
    echo "    mb voice config                  - Check RTC configuration"
    echo "    mb voice tts \"text\" [--play] [-o f] - Text-to-speech (saves MP3)"
    echo ""
    echo ""
    echo "  Skill Hub:"
    echo "    mb skills                        - List all shared skills"
    echo "    mb skills search <query>         - Search skills"
    echo "    mb skills publish <bot> <skill>  - Publish a skill"
    echo "    mb skills install <skill> <bot>  - Install a skill to a bot"
    echo ""
    echo "  Monitoring:"
    echo "    mb stats                         - Cost & usage stats (per-bot, per-user)"
    echo "    mb metrics                       - Prometheus metrics"
    echo ""
    echo "  Voice:"
    echo "    mb voice \"text\" [--play] [-o f]  - Text-to-speech (saves MP3)"
    echo "    mb voice \"text\" --provider doubao - Use specific TTS provider"
    echo "    echo 'hello' | mb voice           - Read from stdin"
    echo ""
    echo "  System:"
    echo "    mb health                        - Health check"
    echo "    mb update                        - Pull latest & rebuild from GitHub"
    ;;
esac
